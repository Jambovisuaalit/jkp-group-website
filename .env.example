# Legacy-yhteensopivuus. Näitä ei tarvita, jos yllä olevat uudet avaimet ovat käytössä.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=jkp-media

# Määritetään vasta varsinaisessa asiakasluovutuksessa Villen nimeämälle pääkäyttäjälle.
# Näihin ei käytetä toteuttajan henkilökohtaista sähköpostia tai nimeä.
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=

# Automaattinen lomakelähetys. Tämä on sivuston julkinen asiakasyhteys, ei hallintatunnus.
