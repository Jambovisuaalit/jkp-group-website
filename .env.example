NEXT_PUBLIC_SITE_URL=https://jkpgroup.fi

# Valitse eksplisiittisesti "static" tai "supabase". Static estää CMS-kirjoitukset.
DATA_BACKEND=static

# JKP Groupin oma Supabase-projekti.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=

# Supabase Authin publishable-avain ja vain palvelimelle kuuluva secret-avain.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy-yhteensopivuus. Näitä ei tarvita, jos yllä olevat uudet avaimet ovat käytössä.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=jkp-media

# Määritetään vasta varsinaisessa asiakasluovutuksessa Villen nimeämälle pääkäyttäjälle.
# Näihin ei käytetä toteuttajan henkilökohtaista sähköpostia tai nimeä.
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=

# Automaattinen lomakelähetys. Tämä on sivuston julkinen asiakasyhteys, ei hallintatunnus.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="JKP Group <verkkosivu@jkpgroup.fi>"
CONTACT_TO_EMAIL=jari.koskela@jkpgroup.fi
