SUPABASE_URL=https://tpjkryxepyfbrldabacp.supabase.co

# Nykyiset Supabase/Vercel Marketplace -avaimet.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
